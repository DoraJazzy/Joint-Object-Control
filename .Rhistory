.groups = "drop"
)
# Check
glimpse(dyad_means)
# 16. Calculate mean RT
mean_RT_data <- analysis_data %>%
group_by(
participant_id,
condition,
phase,
contribution_angle
) %>%
summarise(
mean_RT = mean(RT, na.rm = TRUE),
n_trials = n(),
.groups = "drop"
)
# Check
glimpse(mean_RT_data)
mean_RT_data %>%
count(condition, phase, contribution_angle)
# 17. Calculate mean DIST
mean_DIST_data <- analysis_data %>%
group_by(
participant_id,
condition,
phase,
contribution_angle
) %>%
summarise(
mean_DIST = mean(DIST, na.rm = TRUE),
n_trials = n(),
.groups = "drop"
)
# Check
glimpse(mean_DIST_data)
mean_DIST_data %>%
